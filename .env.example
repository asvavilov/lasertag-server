# Add all of the environmental variables here instead of
# embedding them directly in the app and utilize them
# with the `DotEnv` package.

PORT=8443

BOT_ID=
BOT_SECRET=

BOT=@
ME=
TEST_GROUP=
RONIN_GROUP=
MEN_GROUP=

GIPHY_API_KEY=

VK_KEY=
VK_GROUP=
VK_CONFIRM=
VK_SECRET=

# VK-чаты, где разрешены картинки вместо текстовых отговорок (аналог ME/TEST_GROUP/MEN_GROUP в TG), id через запятую
VK_UNCEN=2000000001
